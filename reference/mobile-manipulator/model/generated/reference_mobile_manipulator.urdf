  </joint>
  <joint name="joint_3" type="revolute">
    <parent link="arm_link_2" />
    <child link="arm_link_3" />
    <origin xyz="0.35 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.2" upper="2.2" effort="100" velocity="1.5" />
  </joint>
  <joint name="joint_4" type="revolute">
