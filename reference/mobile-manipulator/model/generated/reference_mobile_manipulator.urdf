<?xml version='1.0' encoding='utf-8'?>
<robot name="reference_mobile_manipulator">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0" />
      <mass value="100" />
      <inertia ixx="8" ixy="0" ixz="0" iyy="10" iyz="0" izz="12" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
      <geometry>
        <box size="0.8 0.6 0.4" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
