  <link name="arm_link_5">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="3" />
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02" />
