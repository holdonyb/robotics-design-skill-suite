    <child link="arm_link_4" />
    <origin xyz="0.3 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="60" velocity="2" />
  </joint>
  <joint name="joint_5" type="revolute">
