    <child link="arm_link_5" />
    <origin xyz="0.2 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2" upper="2" effort="40" velocity="2" />
  </joint>
  <joint name="joint_6" type="revolute">
    <parent link="arm_link_5" />
    <child link="arm_link_6" />
    <origin xyz="0.12 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="25" velocity="2.5" />
  </joint>
  <link name="tool0" />
  <joint name="tool0_fixed" type="fixed">
    <parent link="arm_link_6" />
    <child link="tool0" />
    <origin xyz="0.1 0 0" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />
  <joint name="imu_fixed" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>
  <ros2_control name="reference_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="joint_2">
