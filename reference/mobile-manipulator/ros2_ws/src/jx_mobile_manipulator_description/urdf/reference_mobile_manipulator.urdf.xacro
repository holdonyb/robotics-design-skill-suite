<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reference_mobile_manipulator">
  <xacro:arg name="use_sim" default="true"/>
  <material name="jx_blue"><color rgba="0.12 0.32 0.62 1"/></material>
  <material name="jx_dark"><color rgba="0.12 0.12 0.14 1"/></material>
  <xacro:macro name="inertial" params="mass ixx iyy izz">
    <inertial><mass value="${mass}"/><inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/></inertial>
  </xacro:macro>
  <xacro:macro name="cylinder_link" params="name radius length mass ixx iyy izz">
    <link name="${name}">
      <xacro:inertial mass="${mass}" ixx="${ixx}" iyy="${iyy}" izz="${izz}"/>
      <visual><geometry><cylinder radius="${radius}" length="${length}"/></geometry><material name="jx_blue"/></visual>
      <collision><geometry><cylinder radius="${radius}" length="${length}"/></geometry></collision>
    </link>
  </xacro:macro>
  <link name="base_link">
    <xacro:inertial mass="100" ixx="8" iyy="10" izz="12"/>
    <visual><origin xyz="0 0 0.2"/><geometry><box size="0.8 0.6 0.4"/></geometry><material name="jx_blue"/></visual>
    <collision><origin xyz="0 0 0.2"/><geometry><box size="0.8 0.6 0.4"/></geometry></collision>
  </link>
  <xacro:cylinder_link name="left_wheel_link" radius="0.15" length="0.08" mass="5" ixx="0.03" iyy="0.06" izz="0.03"/>
  <xacro:cylinder_link name="right_wheel_link" radius="0.15" length="0.08" mass="5" ixx="0.03" iyy="0.06" izz="0.03"/>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.34 0.15" rpy="1.57079632679 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.34 0.15" rpy="1.57079632679 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="front_caster_link"><visual><geometry><sphere radius="0.04"/></geometry></visual><collision><geometry><sphere radius="0.04"/></geometry></collision><xacro:inertial mass="0.5" ixx="0.001" iyy="0.001" izz="0.001"/></link>
  <joint name="front_caster_joint" type="fixed"><parent link="base_link"/><child link="front_caster_link"/><origin xyz="0.3 0 0.04"/></joint>
  <link name="rear_caster_link"><visual><geometry><sphere radius="0.04"/></geometry></visual><collision><geometry><sphere radius="0.04"/></geometry></collision><xacro:inertial mass="0.5" ixx="0.001" iyy="0.001" izz="0.001"/></link>
  <joint name="rear_caster_joint" type="fixed"><parent link="base_link"/><child link="rear_caster_link"/><origin xyz="-0.3 0 0.04"/></joint>
  <xacro:cylinder_link name="arm_link_1" radius="0.09" length="0.18" mass="8" ixx="0.12" iyy="0.12" izz="0.08"/>
  <xacro:cylinder_link name="arm_link_2" radius="0.075" length="0.35" mass="7" ixx="0.10" iyy="0.10" izz="0.06"/>
  <xacro:cylinder_link name="arm_link_3" radius="0.065" length="0.30" mass="5" ixx="0.07" iyy="0.07" izz="0.04"/>
  <xacro:cylinder_link name="arm_link_4" radius="0.055" length="0.20" mass="4" ixx="0.05" iyy="0.05" izz="0.03"/>
  <xacro:cylinder_link name="arm_link_5" radius="0.045" length="0.12" mass="3" ixx="0.03" iyy="0.03" izz="0.02"/>
  <xacro:cylinder_link name="arm_link_6" radius="0.04" length="0.10" mass="2" ixx="0.02" iyy="0.02" izz="0.01"/>
  <joint name="joint_1" type="revolute"><parent link="base_link"/><child link="arm_link_1"/><origin xyz="0 0 0.55"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="120" velocity="1.5"/></joint>
  <joint name="joint_2" type="revolute"><parent link="arm_link_1"/><child link="arm_link_2"/><origin xyz="0 0 0.18"/><axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="120" velocity="1.2"/></joint>
  <joint name="joint_3" type="revolute"><parent link="arm_link_2"/><child link="arm_link_3"/><origin xyz="0.35 0 0"/><axis xyz="0 1 0"/><limit lower="-2.2" upper="2.2" effort="100" velocity="1.5"/></joint>
  <joint name="joint_4" type="revolute"><parent link="arm_link_3"/><child link="arm_link_4"/><origin xyz="0.30 0 0"/><axis xyz="1 0 0"/><limit lower="-3.14" upper="3.14" effort="60" velocity="2"/></joint>
  <joint name="joint_5" type="revolute"><parent link="arm_link_4"/><child link="arm_link_5"/><origin xyz="0.20 0 0"/><axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="40" velocity="2"/></joint>
  <joint name="joint_6" type="revolute"><parent link="arm_link_5"/><child link="arm_link_6"/><origin xyz="0.12 0 0"/><axis xyz="1 0 0"/><limit lower="-3.14" upper="3.14" effort="25" velocity="2.5"/></joint>
  <link name="tool0"/><joint name="tool0_fixed" type="fixed"><parent link="arm_link_6"/><child link="tool0"/><origin xyz="0.10 0 0"/></joint>
  <link name="imu_link"/><joint name="imu_fixed" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.35"/></joint>
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.055" length="0.04"/></geometry><material name="jx_dark"/></visual>
    <collision><geometry><cylinder radius="0.055" length="0.04"/></geometry></collision>
    <xacro:inertial mass="0.2" ixx="0.0001" iyy="0.0001" izz="0.0002"/>
  </link>
  <joint name="lidar_fixed" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.28 0 0.43"/></joint>
  <xacro:if value="$(arg use_sim)">
  <ros2_control name="reference_sim_system" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="joint_1"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_2"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_3"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_4"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_5"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_6"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="left_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo><plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(find jx_mobile_manipulator_sim)/config/controllers.yaml</parameters></plugin></gazebo>
  <gazebo reference="imu_link"><sensor name="base_imu" type="imu"><always_on>true</always_on><update_rate>100</update_rate><topic>/imu/data</topic></sensor></gazebo>
  <gazebo reference="lidar_link"><sensor name="navigation_lidar" type="gpu_lidar"><always_on>true</always_on><update_rate>20</update_rate><topic>/scan</topic><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan><range><min>0.08</min><max>20</max><resolution>0.01</resolution></range></lidar></sensor></gazebo>
  </xacro:if>
</robot>
